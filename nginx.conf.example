#   ssl_certificate_key /etc/letsencrypt/live/botfood.id/privkey.pem;
#   include /etc/letsencrypt/options-ssl-nginx.conf;
#   ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
#
#   # ... (sama dengan block HTTP di atas)
# }
